# Copia aquest fitxer com a .env.production al servidor i omple els valors

# Contrasenya per accedir com a director (obligatòria)
DIRECTOR_PASSWORD=canvia_aquesta_contrasenya

# Secret per xifrar les cookies de sessió (mínim 32 caràcters, genera'n un aleatòri)
# Exemple: openssl rand -hex 32
SESSION_SECRET=

# Clau API d'Anthropic (opcional, necessària per a OCR de fulls de puntuació)
ANTHROPIC_API_KEY=

# Posa "true" NOMÉS si serveixes per HTTPS real (p.ex. darrere de Nginx amb
# certificat). Si ho deixes buit/false en un servidor casolà sense HTTPS,
# el login de director funcionarà per IP/HTTP; amb "true" sense HTTPS el
# navegador descartarà la cookie de sessió i el login no es mantindrà.
COOKIE_SECURE=false
